classDiagram
    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class Owner {
        +str name
        +int available_minutes_per_day
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +str special_needs
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() List~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +time scheduled_time
        +str recurrence
        +bool completed
        +Pet pet
        +mark_complete() void
        +is_due(date) bool
    }

    class ScheduledItem {
        +Task task
        +time start_time
        +str reason
        +end_minutes() int
        +overlaps(other) bool
    }

    class Scheduler {
        +Owner owner
        +generate_plan(date) List~ScheduledItem~
        +sort_tasks(tasks) List~Task~
        +filter_by_time(tasks) List~Task~
        +detect_conflicts(plan) List~ScheduledItem~
        +explain_plan(plan) str
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Task "0..*" --> "1" Pet : belongs to
    Task --> Priority : has
    ScheduledItem --> Task : wraps
    Scheduler --> Owner : uses constraints from
    Scheduler ..> ScheduledItem : produces
