classDiagram
    class Owner {
        +str name
        +int available_minutes_per_day
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +str special_needs
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() List~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +time scheduled_time
        +str recurrence
        +bool completed
        +mark_complete() void
        +is_due(date) bool
    }

    class Scheduler {
        +Owner owner
        +generate_plan(date) List~Task~
        +sort_tasks(tasks) List~Task~
        +filter_by_time(tasks) List~Task~
        +detect_conflicts(tasks) List~Task~
        +explain_plan() str
    }

    Owner "1" --> "1..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : uses constraints from
    Scheduler ..> Task : schedules
